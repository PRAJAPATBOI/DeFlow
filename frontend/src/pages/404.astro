---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <main class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <p class="font-display text-7xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-3 text-xl font-bold text-slate-900">This page doesn’t exist</h1>
    <p class="mt-1 text-sm text-slate-500">The link may be broken or the page may have moved.</p>
    <a href="/" class="mt-6 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Back to dashboard</a>
  </main>
</Base>
