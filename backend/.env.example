# Copy to backend/.env and adjust. Every value has a sensible development default.

# development | production  (production refuses to start without a real SECRET_KEY)
ENVIRONMENT=development

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Session length for issued JWTs
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite by default (backend/dealflow360.db). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://dealflow:dealflow@localhost:5432/dealflow360
# DATABASE_URL=

# Origins allowed to call the API from a browser (only needed when the frontend is served separately)
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Load the demo dataset on first start when the database is empty
SEED_ON_START=true
